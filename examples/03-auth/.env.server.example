# SPFN backend only, never loaded by Next.js. Copy to .env.server and never commit
# the populated file.
NODE_ENV=development
SPFN_LOG_LEVEL=debug
DATABASE_URL=postgresql://spfn:spfn@localhost:55432/spfn_dev
CACHE_URL=redis://localhost:56379
SPFN_AUTH_VERIFICATION_TOKEN_SECRET=<generate-a-random-secret-with-at-least-32-characters>
SPFN_AUTH_TOKEN_ENCRYPTION_KEYS=v1:<base64-output-of-openssl-rand-base64-32>

# Admin seeding: createAuthLifecycle() creates this account (role: superadmin) on
# boot if missing. Password rules: 8+ chars with upper, lower, number, and special
# character. The seeded account has passwordChangeRequired=true; for per-account
# role/passwordChangeRequired control use SPFN_AUTH_ADMIN_ACCOUNTS (JSON) instead.
SPFN_AUTH_ADMIN_EMAIL=admin@example.com
SPFN_AUTH_ADMIN_PASSWORD=<like-SecureAdmin123!>

# Google Login: OAuth client ID + secret from Google Cloud Console. The redirect URI
# defaults to {app origin}/_auth/oauth/google/callback — register that URI in the console.
SPFN_AUTH_GOOGLE_CLIENT_ID=
SPFN_AUTH_GOOGLE_CLIENT_SECRET=

# Kakao Login: REST API key is required; client secret is optional.
SPFN_AUTH_KAKAO_CLIENT_ID=
SPFN_AUTH_KAKAO_CLIENT_SECRET=
SPFN_AUTH_KAKAO_SCOPES=account_email
SPFN_AUTH_KAKAO_REDIRECT_URI=http://localhost:3890/_auth/oauth/kakao/callback

# Naver Login: client ID and secret are both required.
SPFN_AUTH_NAVER_CLIENT_ID=
SPFN_AUTH_NAVER_CLIENT_SECRET=
SPFN_AUTH_NAVER_REDIRECT_URI=http://localhost:3890/_auth/oauth/naver/callback

# GitHub Login: OAuth app client ID and secret are both required.
SPFN_AUTH_GITHUB_CLIENT_ID=
SPFN_AUTH_GITHUB_CLIENT_SECRET=
SPFN_AUTH_GITHUB_REDIRECT_URI=http://localhost:3890/_auth/oauth/github/callback
