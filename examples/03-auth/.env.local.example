# Next.js process only (server routes, RPC proxy, SSR) plus NEXT_PUBLIC_* for the browser.
# Backend-only keys live in .env.server.example. Copy to .env.local and replace the placeholder.
SPFN_API_URL=http://localhost:8890
NEXT_PUBLIC_SPFN_APP_URL=http://localhost:3890
SPFN_AUTH_SESSION_SECRET=<generate-a-random-secret-with-at-least-32-characters>
