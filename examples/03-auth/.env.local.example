# Shared with the Next.js process. Copy to .env.local and replace secret placeholders.
NODE_ENV=development
SPFN_LOG_LEVEL=debug
DATABASE_URL=postgresql://spfn:spfn@localhost:55432/spfn_dev
CACHE_URL=redis://localhost:56379
SPFN_API_URL=http://localhost:8890
NEXT_PUBLIC_SPFN_APP_URL=http://localhost:3890
SPFN_AUTH_SESSION_SECRET=<generate-a-random-secret-with-at-least-32-characters>
