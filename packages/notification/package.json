{
  "name": "@spfn/notification",
  "version": "0.1.0-beta.26",
  "type": "module",
  "description": "Multi-channel notification system for SPFN - Email, SMS, Slack, Push",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.js"
    }
  },
  "scripts": {
    "build": "pnpm check:circular && tsup",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:circular": "madge --circular --extensions ts src/",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "keywords": [
    "spfn",
    "notification",
    "email",
    "sms",
    "slack",
    "push",
    "aws-ses",
    "aws-sns"
  ],
  "author": "Ray Im <rayim@fxy.global>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spfn/spfn.git",
    "directory": "packages/notification"
  },
  "homepage": "https://github.com/spfn/spfn/tree/main/packages/notification#readme",
  "bugs": {
    "url": "https://github.com/spfn/spfn/issues"
  },
  "peerDependencies": {
    "@spfn/core": ">=0.2.0-beta.54",
    "@aws-sdk/client-sesv2": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sesv2": {
      "optional": true
    },
    "@aws-sdk/client-sns": {
      "optional": true
    }
  },
  "devDependencies": {
    "@spfn/core": "workspace:*",
    "@aws-sdk/client-sesv2": "^3.1024.0",
    "@sinclair/typebox": "^0.34.30",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.0",
    "madge": "^8.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.6"
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "spfn": {
    "schemas": [
      "./dist/entities/*.js"
    ],
    "migrations": {
      "dir": "./migrations"
    }
  }
}
