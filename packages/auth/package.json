{
  "name": "@spfn/auth",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Authentication, authorization, and RBAC module for SPFN",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "npm run db:generate && tsup",
    "watch": "tsup --watch",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist migrations",
    "db:generate": "drizzle-kit generate",
    "test": "vitest",
    "test:routes": "vitest src/routes",
    "docker:test:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker compose -f docker-compose.test.yml down",
    "docker:test:logs": "docker compose -f docker-compose.test.yml logs -f"
  },
  "keywords": [
    "spfn",
    "auth",
    "authentication",
    "authorization",
    "rbac",
    "access-control"
  ],
  "license": "MIT",
  "spfn": {
    "schemas": [
      "./dist/entities/*.js"
    ],
    "routes": {
      "basePath": "/auth",
      "dir": "./dist/routes"
    },
    "migrations": {
      "dir": "./migrations"
    },
    "setupMessage": "  📚 Next steps:\n    1. Import auth: import { authMiddleware } from '@spfn/auth/middleware'\n    2. View tables: pnpm spfn db studio\n    3. API at: http://localhost:8790/auth"
  },
  "dependencies": {
    "@spfn/core": "workspace:*",
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.44.6",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.31.6",
    "glob": "^11.0.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}