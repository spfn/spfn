{
  "name": "spfn",
  "version": "0.2.0-beta.53",
  "description": "Superfunction CLI - Add SPFN to your Next.js project",
  "type": "module",
  "bin": {
    "spfn": "./bin/spfn.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-templates.js",
    "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "spfn",
    "cli",
    "nextjs",
    "backend",
    "framework",
    "generator",
    "crud-generator",
    "scaffolding",
    "boilerplate",
    "dev-tools",
    "development",
    "init",
    "typescript",
    "type-safe"
  ],
  "author": "Ray Im <rayim@fxy.global>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spfn/spfn.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://git.superfunction.xyz/api/packages/superfunction/npm/"
  },
  "bugs": {
    "url": "https://github.com/spfn/spfn/issues"
  },
  "homepage": "https://github.com/spfn/spfn/tree/main/packages/cli#readme",
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "@spfn/core": ">=0.2.0-beta.54",
    "typescript": "^5.3.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": "^11.1.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.45.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.1",
    "pg": "^8.16.3",
    "postgres": "^3.4.0",
    "prompts": "^2.4.2",
    "tsup": "^8.5.0",
    "yaml": "^2.5.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.1.0"
  },
  "devDependencies": {
    "@spfn/core": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/prompts": "^2.4.9",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  }
}
