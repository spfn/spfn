{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "spfn://landing-kit/contracts/kit-operation-journal/v1",
    "title": "KitOperationJournalV1",
    "description": "Resumable operation journal (unit 06 section 5.2) with the two extra wait states unit 10 requires: waiting-cloud at the provisioning checkpoint (section 6.2 step 7) and waiting-settlement at the analytics checkpoint (section 3.1). Never carries a secret: no license key, credential, registry session, DB URL, provider token, email challenge or raw command environment.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "operationId",
        "type",
        "kitId",
        "sourceRelease",
        "targetRelease",
        "manifestDigest",
        "planDigest",
        "phase",
        "status",
        "checkpoints",
        "externalRefs",
        "createdAt",
        "updatedAt"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "operationId": { "$ref": "#/$defs/publicId" },
        "type": { "enum": ["install", "restore", "update", "move", "rollback"] },
        "kitId": { "$ref": "#/$defs/publicId" },
        "sourceRelease": { "oneOf": [{ "$ref": "#/$defs/version" }, { "type": "null" }] },
        "targetRelease": { "$ref": "#/$defs/version" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "planDigest": { "$ref": "#/$defs/digest" },
        "phase": { "$ref": "#/$defs/publicId" },
        "status": { "$ref": "#/$defs/operationStatus" },
        "checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/checkpoint" }
        },
        "externalRefs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "activationId": { "$ref": "#/$defs/publicId" },
                "backupId": { "$ref": "#/$defs/publicId" },
                "sourceCommit": { "$ref": "#/$defs/commit" },
                "pushedCommit": { "$ref": "#/$defs/commit" },
                "deploymentId": { "$ref": "#/$defs/publicId" }
            }
        },
        "createdAt": { "$ref": "#/$defs/instant" },
        "updatedAt": { "$ref": "#/$defs/instant" }
    },
    "$defs": {
        "publicId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)*$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
        "operationStatus": {
            "enum": [
                "active",
                "waiting-approval",
                "waiting-cloud",
                "waiting-settlement",
                "failed",
                "completed",
                "abandoned"
            ]
        },
        "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
                "id": { "$ref": "#/$defs/checkpointId" },
                "status": { "enum": ["pending", "completed", "failed"] },
                "evidenceDigest": { "$ref": "#/$defs/digest" },
                "completedAt": { "$ref": "#/$defs/instant" },
                "resumeAfter": {
                    "$ref": "#/$defs/instant",
                    "description": "Section 3.1: settlement is not a process sleep. The settlement checkpoint records resumeAfter = lastAcceptedAt + 31 minutes and a scheduler resumes the same operation."
                }
            }
        },
        "checkpointId": {
            "description": "Resume identity. A resume matches the journal to a checkpoint by this ID and re-reads the real world before trusting the recorded phase.",
            "enum": [
                "descriptor-verified",
                "catalog-verified",
                "activation-complete",
                "materialize-complete",
                "install-frozen",
                "routes-generated",
                "waiting-cloud",
                "plan-approved",
                "provider-provisioned",
                "migration-applied",
                "local-gates-passed",
                "deploy-bootstrapped",
                "staged-verified",
                "promoted",
                "browser-captured",
                "waiting-settlement",
                "ops-reported"
            ]
        }
    }
}
