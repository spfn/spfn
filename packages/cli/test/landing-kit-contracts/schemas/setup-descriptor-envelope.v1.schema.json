{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "spfn://landing-kit/contracts/setup-descriptor-envelope/v1",
    "title": "SetupDescriptorEnvelopeV1",
    "description": "Generic setup descriptor envelope owned by the spfn CLI. The envelope carries no product judgement: the product payload is opaque bytes identified by payloadKind and pinned by payloadDigest.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "descriptorId",
        "productId",
        "productKind",
        "issuedAt",
        "expiresAt",
        "setupUrl",
        "displayName",
        "supportUrl",
        "cli",
        "catalogUrl",
        "manifestUrl",
        "payloadKind",
        "payloadDigest",
        "payload"
    ],
    "properties": {
        "schemaVersion": { "const": 1 },
        "descriptorId": { "$ref": "#/$defs/publicId" },
        "productId": { "$ref": "#/$defs/publicId" },
        "productKind": { "enum": ["kit"] },
        "issuedAt": { "$ref": "#/$defs/instant" },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "setupUrl": { "$ref": "#/$defs/setupUrl" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "supportUrl": { "$ref": "#/$defs/httpsUrl" },
        "cli": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "recommendedVersion", "minimumVersion"],
            "properties": {
                "package": { "const": "spfn" },
                "recommendedVersion": { "$ref": "#/$defs/version" },
                "minimumVersion": { "$ref": "#/$defs/version" }
            }
        },
        "catalogUrl": { "$ref": "#/$defs/httpsUrl" },
        "manifestUrl": { "$ref": "#/$defs/httpsUrl" },
        "payloadKind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9./-]{0,79}@[0-9]+$" },
        "payloadDigest": { "$ref": "#/$defs/digest" },
        "payload": { "type": "object" }
    },
    "$defs": {
        "publicId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
        "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)*$" },
        "httpsUrl": { "type": "string", "pattern": "^https://[a-z0-9.-]+(:[0-9]+)?(/[^\\s?#]*)?$" },
        "setupUrl": {
            "type": "string",
            "description": "Public allowlisted locator. Query and fragment are forbidden so a license key, order token, email or entitlement can never ride along. An explicit port is allowed, because a certification environment serves the descriptor from one; https stays mandatory here, and deciding which origins are acceptable remains the CLI allowlist's job, not this pattern's. Userinfo in the authority is still refused, so credentials cannot be smuggled through the locator.",
            "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?/setup/[a-z0-9][a-z0-9._-]{0,79}$"
        }
    }
}
