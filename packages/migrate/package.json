{
    "name": "@spfn/migrate",
    "version": "0.2.0-beta.1",
    "description": "Code-based data migrations with a run-once ledger for SPFN apps.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "type-check": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "prepack": "node -e \"require('fs').copyFileSync('../../LICENSE','LICENSE')\"",
        "publish:alpha": "node ../../scripts/publish-package.mjs alpha",
        "publish:beta": "node ../../scripts/publish-package.mjs beta",
        "publish:latest": "node ../../scripts/publish-package.mjs latest"
    },
    "spfn": {
        "schemas": [
            "./dist/server/entities/*.js"
        ],
        "migrations": {
            "dir": "./migrations"
        }
    },
    "peerDependencies": {
        "@spfn/core": ">=0.3.0-beta.1 <0.4.0",
        "drizzle-orm": ">=1.0.0-rc.4 <2"
    },
    "devDependencies": {
        "@spfn/core": "workspace:*",
        "@types/node": "^20.11.0",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "tsup": "^8.5.0",
        "typescript": "^5.3.3"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fxylabs/spfn.git",
        "directory": "packages/migrate"
    },
    "bugs": {
        "url": "https://github.com/fxylabs/spfn/issues"
    },
    "homepage": "https://github.com/fxylabs/spfn/tree/main/packages/migrate#readme",
    "publishConfig": {
        "access": "public",
        "tag": "beta"
    }
}
