# =============================================================================
# CMS Environment Variables
# =============================================================================
# Auto-generated from environment schema
# See packages/cms/src/server/config/env.config.ts for full configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Locale Configuration
# -----------------------------------------------------------------------------

# Default language for CMS content
# Examples: en, ko, ja, zh
# Default: en
SPFN_CMS_DEFAULT_LOCALE=en

# Comma-separated list of supported languages
# Examples: en,ko | en,ko,ja | en,ko,ja,zh,es,fr
# Default: en,ko
SPFN_CMS_LOCALES=en,ko

# Automatically detect and use browser language
# Default: true
SPFN_CMS_DETECT_BROWSER_LANGUAGE=true

# Directory path for JSON label files (relative to project root)
# Examples: src/lib/labels | src/content/labels | labels
# Default: src/lib/labels
SPFN_CMS_LABELS_DIR=src/lib/labels

# -----------------------------------------------------------------------------
# Backward Compatibility (Deprecated)
# -----------------------------------------------------------------------------

# [DEPRECATED] Use SPFN_CMS_LOCALES instead
# Comma-separated list of supported languages
# SPFN_CMS_SUPPORTED_LOCALES=en,ko
