{
  "name": "spfn",
  "private": true,
  "version": "0.1.0-alpha.26",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "sync:guides": "node scripts/sync-guides.js",
    "test:init": "node scripts/test-init.mjs",
    "publish:packages": "pnpm build --filter=\"!./apps/*\" && pnpm --filter \"./packages/*\" publish --tag alpha --access public",
    "publish:alpha": "pnpm publish:packages",
    "version:bump": "pnpm --filter \"./packages/*\" version"
  },
  "devDependencies": {
    "chalk": "^5.6.2",
    "dotenv-cli": "^10.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.2",
    "ora": "^8.2.0",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.1.2",
  "engines": {
    "node": ">=18.18.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.41",
    "drizzle-typebox": "^0.3.3"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "drizzle-orm": "^0.45.0",
      "next": "^16.0.10"
    }
  }
}
